model Appointment {
    id              String            @id @default(uuid())
    patientId       String
    doctorId        String
    appointmentDate DateTime
    status          AppointmentStatus @default(PENDING)
    paymentStatus   PaymentStatus     @default(PENDING)
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    payment         Payment?          

    @@index([patientId])
    @@index([doctorId])
    @@map("appointments")
}
