<%
  const brand = locals.appName || 'Health Care';
  const supportEmail = locals.supportEmail || '';
  const changedAt = locals.changedAt || '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>Password changed</title>
</head>
<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:'Segoe UI', Helvetica, Arial, sans-serif;">

  <!-- Preheader -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">
    Your password was changed successfully.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9; padding:32px 16px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(15,23,42,0.08);">

          <!-- Header -->
          <tr>
            <td align="center" style="background:linear-gradient(135deg,#10b981,#059669); background-color:#059669; padding:36px 24px;">
              <div style="width:56px; height:56px; line-height:56px; border-radius:50%; background-color:rgba(255,255,255,0.2); color:#ffffff; font-size:28px; text-align:center; margin:0 auto 14px;">
                &#10003;
              </div>
              <h1 style="margin:0; color:#ffffff; font-size:22px; font-weight:700; letter-spacing:0.3px;">
                <%= brand %>
              </h1>
              <p style="margin:6px 0 0; color:#d1fae5; font-size:14px;">Password Changed Successfully</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:36px 32px 12px;">
              <p style="margin:0 0 12px; color:#0f172a; font-size:18px; font-weight:600;">
                Hello, <%= name %> 👋
              </p>
              <p style="margin:0; color:#475569; font-size:15px; line-height:1.7;">
                Your password has been reset successfully. You can now log in to your account with your new password.
              </p>
            </td>
          </tr>

          <!-- Details -->
          <% if (changedAt) { %>
          <tr>
            <td style="padding:20px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ecfdf5; border:1px solid #a7f3d0; border-radius:10px;">
                <tr>
                  <td style="padding:14px 16px; color:#065f46; font-size:13px; line-height:1.6;">
                    <strong>Changed on:</strong> <%= changedAt %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <% } %>

          <!-- Warning box -->
          <tr>
            <td style="padding:24px 32px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fef2f2; border-left:4px solid #ef4444; border-radius:8px;">
                <tr>
                  <td style="padding:14px 16px; color:#991b1b; font-size:13px; line-height:1.6;">
                    <strong>Wasn't you?</strong> If you didn't make this change, your account may be at risk.
                    <% if (supportEmail) { %>
                      Please contact us immediately at
                      <a href="mailto:<%= supportEmail %>" style="color:#991b1b; font-weight:600;"><%= supportEmail %></a>.
                    <% } else { %>
                      Please contact our support team immediately.
                    <% } %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f8fafc; padding:20px 24px; border-top:1px solid #e2e8f0;">
              <p style="margin:0; color:#94a3b8; font-size:12px; line-height:1.6;">
                This is an automated message, please do not reply.<br />
                &copy; <%= new Date().getFullYear() %> <%= brand %>. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>