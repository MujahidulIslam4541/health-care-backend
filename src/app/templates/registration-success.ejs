<%
  const brand = locals.appName || 'Health Care';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>Welcome to <%= brand %></title>
</head>
<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:'Segoe UI', Helvetica, Arial, sans-serif;">

  <!-- Preheader (inbox preview text) -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">
    Your account has been created successfully. Welcome to <%= brand %>!
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9; padding:32px 16px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(15,23,42,0.08);">

          <!-- Header -->
          <tr>
            <td align="center" style="background:linear-gradient(135deg,#10b981,#059669); background-color:#059669; padding:40px 24px;">
              <div style="width:64px; height:64px; line-height:64px; border-radius:50%; background-color:rgba(255,255,255,0.2); color:#ffffff; font-size:32px; text-align:center; margin:0 auto 16px;">
                &#10003;
              </div>
              <h1 style="margin:0; color:#ffffff; font-size:24px; font-weight:700; letter-spacing:0.3px;">
                Welcome to <%= brand %>!
              </h1>
              <p style="margin:8px 0 0; color:#d1fae5; font-size:14px;">Your account is ready</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:36px 32px 12px;">
              <p style="margin:0 0 12px; color:#0f172a; font-size:18px; font-weight:600;">
                Hello, <%= name %> 🎉
              </p>
              <p style="margin:0 0 14px; color:#475569; font-size:15px; line-height:1.7;">
                Your registration was successful and your email has been verified. We're excited to have you with us at <strong style="color:#0f172a;"><%= brand %></strong>.
              </p>
              <p style="margin:0; color:#475569; font-size:15px; line-height:1.7;">
                You can now log in to your account and start exploring.
              </p>
            </td>
          </tr>

          <!-- Info box -->
          <tr>
            <td style="padding:24px 32px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ecfdf5; border:1px solid #a7f3d0; border-radius:10px;">
                <tr>
                  <td style="padding:14px 16px; color:#065f46; font-size:13px; line-height:1.6;">
                    <strong>Didn't create this account?</strong> Please contact our support team right away so we can secure it.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f8fafc; padding:20px 24px; border-top:1px solid #e2e8f0;">
              <p style="margin:0; color:#94a3b8; font-size:12px; line-height:1.6;">
                This is an automated message, please do not reply.<br />
                &copy; <%= new Date().getFullYear() %> <%= brand %>. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>